# MongoDB
MONGODB_URI=mongodb://localhost:27017/cartola

# JWT
JWT_SECRET=my-secret-key-change-in-production
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=my-refresh-secret-key-change-in-production
JWT_REFRESH_EXPIRES_IN=7d

# Email (Nodemailer)
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=my-email@example.com
EMAIL_PASS=my-email-password
EMAIL_FROM=noreply@example.com

# Server
PORT=3000
