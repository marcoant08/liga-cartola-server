{
  "version": 2,
  "buildCommand": "pnpm run vercel-build",
  "installCommand": "NODE_ENV=development pnpm install --frozen-lockfile",
  "outputDirectory": "public",
  "framework": null,
  "functions": {
    "api/index.js": {
      "memory": 1024,
      "maxDuration": 15
    }
  },
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/api/index.js"
    }
  ]
}
