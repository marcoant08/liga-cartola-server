{
  "version": 2,
  "buildCommand": "pnpm run vercel-build",
  "installCommand": "NODE_ENV=development pnpm install --frozen-lockfile",
  "outputDirectory": "public",
  "framework": null,
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api"
    }
  ],
  "functions": {
    "api/index.ts": {
      "memory": 1024,
      "maxDuration": 15,
      "includeFiles": "api/_nest_dist/**"
    }
  }
}
